{
  "name": "uci_electricity",
  "domain": "regression",
  "adapter": "adapters.regression_csv.RegressionCSVAdapter",
  "status": "awaiting_data",

  "data_path": "data/uci_electricity/uci_electricity.csv",
  "value_column": "value",
  "seq_length": 96,
  "train_frac": 0.8,
  "val_frac": 0.05,
  "stream_delay_s": 0.0,

  "models": {
    "lstm": {
      "weights_path": "managed_system_regression/models/lstm_uci_electricity.pt",
      "loader": "adapters.loaders.lstm_loader",
      "cost_class": "medium"
    },
    "ridge": {
      "weights_path": "managed_system_regression/models/ridge_uci_electricity.pkl",
      "loader": "adapters.loaders.sklearn_loader",
      "cost_class": "light"
    },
    "svr": {
      "weights_path": "managed_system_regression/models/svr_uci_electricity.pkl",
      "loader": "adapters.loaders.sklearn_loader",
      "cost_class": "medium"
    }
  },

  "min_score": 0.50,
  "max_energy": 0.50,
  "E_ref": 0.5,
  "delta": 0.05,
  "beta": 0.95,
  "gamma": 0.8,
  "alpha": 0.1,
  "E_m": 0,
  "E_M": 5000000,
  "tau_drift": 0.05,
  "drift_reference": "both",

  "planner": "harmone_original",
  "energy_required": ["cpu"],

  "_comment": "Client MT_168. Seasonal VMR-reuse showcase. See docs/datasets/uci_electricity.md for DST dedup and preprocessing details."
}
