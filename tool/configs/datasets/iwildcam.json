{
  "name": "iwildcam",
  "domain": "cv",
  "adapter": "adapters.cv_imagedir.CVImageDirAdapter",
  "status": "awaiting_data",
  "manifest_csv": "data/iwildcam/iwildcam_manifest.csv",
  "data_root": ".",
  "seq_length": 1,
  "train_frac": 0.7,
  "val_frac": 0.1,
  "stream_delay_s": 0.0,
  "task": "classification",
  "task_adapter": "adapters.tasks.classification.ClassificationAdapter",
  "num_classes": 182,
  "models": {
    "efficientnet_b0": {
      "weights_path": "managed_system_cv/models/efficientnet_b0_iwildcam.pt",
      "loader": "adapters.loaders.torchvision_loader",
      "cost_class": "light"
    },
    "resnet50": {
      "weights_path": "managed_system_cv/models/resnet50_iwildcam.pt",
      "loader": "adapters.loaders.torchvision_loader",
      "cost_class": "medium"
    },
    "resnet101": {
      "weights_path": "managed_system_cv/models/resnet101_iwildcam.pt",
      "loader": "adapters.loaders.torchvision_loader",
      "cost_class": "heavy"
    }
  },
  "embedding_model": "efficientnet_b0",
  "embedding_dim": 1280,
  "embedding_sample_every": 5,
  "drift_window_size": 500,
  "proxy": "max_softmax",
  "drift_detector": "mmd_embedding",
  "retrain_tactic": "pseudo_label",
  "pseudo_label_threshold": 0.8,
  "rollback_if_worse": true,
  "finetune_n_layers": 10,
  "finetune_lr": 0.0001,
  "finetune_epochs": 3,
  "finetune_min_images": 20,
  "finetune_batch_size": 8,
  "tau_regression": 0.05,
  "min_score": 0.5,
  "min_accuracy": 0.5,
  "max_energy": 0.5,
  "E_ref": 0.5,
  "energy_reference": 0.5,
  "w_acc": 1.0,
  "w_e": 1.0,
  "delta": 0.05,
  "beta": 0.95,
  "gamma": 0.8,
  "alpha": 0.1,
  "E_m": 0,
  "E_M": 10000000,
  "tau_drift": 0.01,
  "drift_reference": "fixed",
  "switch_cooldown_s": 30,
  "planner": "harmone_original",
  "ema_head_start": 0.1,
  "energy_required": [
    "gpu"
  ],
  "_comment": "Geographic drift showcase. embedding-based drift (MMD on EfficientNet-B0 features). See docs/datasets/iwildcam.md. Calibrate tau_drift per hardware.",
  "energy_meter": "nvml"
}