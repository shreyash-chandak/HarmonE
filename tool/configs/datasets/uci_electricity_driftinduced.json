{
  "name": "uci_electricity_driftinduced",
  "domain": "regression",
  "adapter": "adapters.regression_csv.RegressionCSVAdapter",
  "status": "awaiting_data",
  "data_path": "data/uci_electricity/uci_electricity_driftInduced.csv",
  "value_column": "value",
  "seq_length": 96,
  "train_frac": 0.1,
  "val_frac": 0.05,
  "stream_delay_s": 0.0,
  "models": {
    "lstm": {
      "weights_path": "managed_system_regression/models/lstm_uci_electricity.pt",
      "loader": "adapters.loaders.lstm_loader",
      "cost_class": "medium",
      "hyperparams": {
        "train":   {"epochs": 4, "lr": 0.0005, "batch_size": 8},
        "retrain": {"epochs": 50, "lr": 0.001, "batch_size": 16}
      }
    },
    "ridge": {
      "weights_path": "managed_system_regression/models/ridge_uci_electricity.pkl",
      "loader": "adapters.loaders.sklearn_loader",
      "cost_class": "light",
      "hyperparams": {
        "train":   {"alpha": 500},
        "retrain": {"regularisation_factor": 2}
      }
    },
    "svr": {
      "weights_path": "managed_system_regression/models/svr_uci_electricity.pkl",
      "loader": "adapters.loaders.sklearn_loader",
      "cost_class": "medium",
      "hyperparams": {
        "train":   {"kernel": "linear", "C": 0.00035, "tol": 0.001, "epsilon": 0.0005, "max_train_samples": 8000},
        "retrain": {"regularisation_factor": 3}
      }
    }
  },
  "min_score": 0.7917,
  "energy_bounds_source": "calibrate_from_naive_runs:runs_seed1",
  "energy_reference_source": "calibrate_from_naive_runs:runs_seed1 (E_ref = energy_budget_rho)",
  "accuracy_gate_source": "calibrate_from_naive_runs:runs_seed1 (min_accuracy = accuracy_budget_rho rule)",
  "min_accuracy": 0.807,
  "max_energy": 0.5,
  "E_ref": 0.5,
  "energy_reference": 0.5,
  "w_acc": 1.0,
  "w_e": 1.0,
  "delta": 0.05,
  "beta": 0.95,
  "gamma": 0.8,
  "alpha": 0.1,
  "switch_hold_cycles": 3,
  "switch_hold_mode": "after_energy_violation",
  "explore_prob": 0.05,
  "drift_confirmation": "accuracy",
  "drift_accuracy_drop": 0.05,
  "s5_drift_prefers_switch": true,
  "accuracy_signal": "window_r2",
  "retrain_regularisation": "sample_scaled",
  "prt_interval": 3200,
  "energy_metering": "per_prediction",
  "reload_model_per_step": true,
  "energy_budget_rho": 0.5,
  "accuracy_budget_rho": 0.5,
  "staleness_window": 500,
  "s5_switch_margin": 0.02,
  "pareto_switch_margin": 0.02,
  "pareto_switch_cost_lambda": 0.1,
  "pareto_augmentation": 0.01,
  "bandit_alpha": 1.0,
  "bandit_mu": 0.05,
  "bandit_switch_margin": 0.01,
  "bandit_min_observation_steps": 50,
  "drift_cooldown_rows": 1200,
  "max_batches_ahead": 1,
  "E_m": 16737.3,
  "E_M": 134599.2,
  "tau_drift": 1.16452,
  "tau_drift_source": "calibrate_drift_threshold kl_overflow p99 window=1200 null=stream[:4975]",
  "drift_reference": "both",
  "planner": "harmone_original",
  "energy_required": [
    "cpu"
  ],
  "_comment": "Drift-induced sibling of uci_electricity.json, added 2026-08-30 per HarmonE.pdf §4.2-4.3. This dataset is Mode A (one CSV, split by train_frac at read time) so data_path points at the FULL drift-injected file produced by managed_system_regression/utility/drift/induce.py (--dataset uci_electricity) — its training-portion rows (index < len*train_frac) are byte-identical copies of the original, so train_split() is unaffected; only stream() sees the induced drift. weights_path entries are intentionally IDENTICAL to uci_electricity.json's so training (on the unaltered portion, either way) happens once and is reused here. uci_electricity.json itself is untouched, still pointing at the clean CSV — needed e.g. by experiments/calibrate_drift_threshold.py for a genuinely undrifted null distribution. Run induce.py to generate uci_electricity_driftInduced.csv before using this config — nothing creates it automatically. Client MT_168; see docs/datasets/uci_electricity.md.",
  "energy_meter": "rapl"
}
