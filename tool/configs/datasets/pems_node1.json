{
  "name": "pems_node1",
  "domain": "regression",
  "adapter": "adapters.regression_csv.RegressionCSVAdapter",

  "data_path": "../../managed_system_regression/knowledge/dataset.csv",
  "value_column": "flow",
  "seq_length": 5,
  "train_frac": 0.8,
  "val_frac": 0.0,
  "stream_delay_s": 0.15,

  "models": {
    "lstm": {
      "weights_path": "../../managed_system_regression/models/lstm.pth",
      "loader": "adapters.loaders.lstm_loader",
      "cost_class": "heavy"
    },
    "linear": {
      "weights_path": "../../managed_system_regression/models/linear.pkl",
      "loader": "adapters.loaders.sklearn_loader",
      "cost_class": "light"
    },
    "svm": {
      "weights_path": "../../managed_system_regression/models/svm.pkl",
      "loader": "adapters.loaders.sklearn_loader",
      "cost_class": "medium"
    }
  },

  "min_score": 0.78,
  "max_energy": 0.6,
  "E_ref": 0.7,
  "delta": 0.1,
  "beta": 0.95,
  "gamma": 0.8,
  "alpha": 0.1,
  "E_m": 0,
  "E_M": 25000,
  "tau_drift": 0.5,
  "drift_reference": "both",
  "planner": "harmone_original",
  "w_acc": 1.0,
  "w_e": 1.0,

  "energy_required": ["cpu"],

  "_comment_splits": "80/20 chronological split. train_end_index can override train_frac once confirmed from original paper setup (see DECISIONS_PENDING.md DP5)."
}
