{
  "name": "spot_prices_driftinduced",
  "domain": "regression",
  "adapter": "adapters.regression_csv.RegressionCSVAdapter",
  "status": "awaiting_data",
  "data_path": "data/spot_prices/spot_prices_driftInduced.csv",
  "value_column": "value",
  "seq_length": 24,
  "train_frac": 0.6,
  "train_window_rows": 17520,
  "val_frac": 0.15,
  "stream_delay_s": 0.0,
  "models": {
    "lstm": {
      "weights_path": "managed_system_regression/models/lstm_spot_prices.pt",
      "loader": "adapters.loaders.lstm_loader",
      "cost_class": "medium",
      "hyperparams": {
        "train":   {"epochs": 45, "lr": 0.0005, "batch_size": 8},
        "retrain": {"mode": "finetune"}
      }
    },
    "ridge": {
      "weights_path": "managed_system_regression/models/ridge_spot_prices.pkl",
      "loader": "adapters.loaders.sklearn_loader",
      "cost_class": "light",
      "hyperparams": {
        "train":   {"alpha": 5},
        "retrain": {"regularisation_factor": 45}
      }
    },
    "svr": {
      "weights_path": "managed_system_regression/models/svr_spot_prices.pkl",
      "loader": "adapters.loaders.sklearn_loader",
      "cost_class": "medium",
      "hyperparams": {
        "train":   {"kernel": "linear", "C": 0.007, "tol": 0.001, "epsilon": 0.0005, "max_train_samples": 8000},
        "retrain": {"regularisation_factor": 10}
      }
    }
  },
  "min_score": 0.6393,
  "energy_bounds_source": "calibrate_from_naive_runs:runs_seed1",
  "energy_reference_source": "calibrate_from_naive_runs:runs_seed1 (E_ref = energy_budget_rho)",
  "accuracy_gate_source": "calibrate_from_naive_runs:runs_seed1 (min_accuracy = accuracy_budget_rho rule)",
  "min_accuracy": 0.6466,
  "max_energy": 0.5,
  "E_ref": 0.5,
  "energy_reference": 0.5,
  "w_acc": 1.0,
  "w_e": 1.0,
  "delta": 0.05,
  "beta": 0.95,
  "gamma": 0.8,
  "alpha": 0.1,
  "switch_hold_cycles": 3,
  "switch_hold_mode": "after_energy_violation",
  "explore_prob": 0.05,
  "drift_confirmation": "accuracy",
  "drift_accuracy_drop": 0.05,
  "s5_drift_prefers_switch": true,
  "accuracy_signal": "window_r2",
  "retrain_regularisation": "sample_scaled",
  "prt_interval": 3200,
  "energy_metering": "per_prediction",
  "reload_model_per_step": true,
  "energy_budget_rho": 0.5,
  "accuracy_budget_rho": 0.5,
  "staleness_window": 500,
  "s5_switch_margin": 0.02,
  "pareto_switch_margin": 0.02,
  "pareto_switch_cost_lambda": 0.1,
  "pareto_augmentation": 0.01,
  "bandit_alpha": 1.0,
  "bandit_mu": 0.05,
  "bandit_switch_margin": 0.01,
  "bandit_min_observation_steps": 50,
  "drift_cooldown_rows": 1200,
  "max_batches_ahead": 1,
  "E_m": 16341.3,
  "E_M": 109418.4,
  "tau_drift": 1.163284,
  "tau_drift_source": "calibrate_drift_threshold kl_overflow p99 window=1200 null=spot_prices:stream[:50090]",
  "drift_reference": "both",
  "planner": "harmone_original",
  "energy_required": [
    "cpu"
  ],
  "_comment": "Drift-induced sibling of spot_prices.json, added 2026-08-30 per HarmonE.pdf §4.2-4.3. This dataset is Mode A (one CSV, split by train_frac at read time) so data_path points at the FULL drift-injected file produced by managed_system_regression/utility/drift/induce.py (--dataset spot_prices) — its training-portion rows are byte-identical copies of the original, so train_split() is unaffected; only stream() sees the induced drift. weights_path entries are intentionally IDENTICAL to spot_prices.json's so training happens once and is reused here. spot_prices.json itself is untouched, still pointing at the clean CSV — needed e.g. by experiments/calibrate_drift_threshold.py for a genuinely undrifted null distribution. Run induce.py to generate spot_prices_driftInduced.csv before using this config — nothing creates it automatically. ERCOT day-ahead prices 2019-2022; structural break already present at ~2021-02-13 (Winter Storm Uri) even before any induced drift — see docs/datasets/spot_prices.md.",
  "energy_meter": "rapl"
}
