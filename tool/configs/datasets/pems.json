{
  "name": "pems",
  "domain": "regression",
  "adapter": "adapters.regression_csv.RegressionCSVAdapter",

  "train_path": "data/pems/flow_data_train.csv",
  "stream_path": "data/pems/flow_data_test.csv",
  "value_column": "flow",
  "seq_length": 5,
  "stream_delay_s": 0.0,

  "models": {
    "lstm": {
      "weights_path": "managed_system_regression/models/lstm_pems.pt",
      "loader": "adapters.loaders.lstm_loader",
      "cost_class": "heavy",
      "hyperparams": {
        "train":   {"epochs": 4, "lr": 0.0003, "batch_size": 16},
        "retrain": {}
      }
    },
    "ridge": {
      "weights_path": "managed_system_regression/models/ridge_pems.pkl",
      "loader": "adapters.loaders.sklearn_loader",
      "cost_class": "light",
      "hyperparams": {
        "train":   {"alpha": 1000},
        "retrain": {}
      }
    },
    "svr": {
      "weights_path": "managed_system_regression/models/svr_pems.pkl",
      "loader": "adapters.loaders.sklearn_loader",
      "cost_class": "medium",
      "hyperparams": {
        "train":   {"kernel": "linear", "C": 0.0002, "tol": 0.001, "epsilon": 0.0005, "max_train_samples": 8000},
        "retrain": {"window_rows": 2585}
      }
    }
  },

  "min_score": 0.78,
  "min_accuracy": 0.78,
  "max_energy": 0.6,
  "E_ref": 0.26,
  "energy_reference": 0.26,
  "energy_reference_source": "calibrated_replay_harmone_original_20260903",
  "delta": 0.1,
  "beta": 0.95,
  "gamma": 0.8,
  "alpha": 0.1,
  "switch_hold_cycles": 3,
  "explore_prob": 0.05,
  "drift_cooldown_rows": 1200,
  "max_batches_ahead": 1,
  "E_m": 300,
  "E_M": 15000,
  "energy_bounds_source": "calibrated_p99.5_pooled_batch_logs_20260902",
  "tau_drift": 0.5,
  "tau_drift_source": "paper_default",
  "drift_reference": "both",
  "planner": "harmone_original",
  "w_acc": 1.0,
  "w_e": 1.0,
  "energy_required": ["cpu"],
  "energy_meter": "rapl",

  "_comment": "Original HarmonE PeMS dataset. Data is pre-split: flow_data_train.csv (~892 observations, 10%) is the initialization portion; flow_data_test.csv (~8 036 observations, 90%) is the streaming evaluation stream. Thresholds match the published paper values. E_M recalibrated 2026-09-02 from pooled mape_events.csv logs across all pems_driftinduced planner runs (lstm batch energy: p99=13346, p99.5=15216 uJ) — the previous E_M=12000 sat below lstm's own p99, causing spurious 'energy' violations on ordinary measurement noise (see runs/energy_calibration_pems.json once experiments/calibrate_energy_bounds.py has been re-run against retrained weights). Re-run that script and update this value whenever weights are retrained or hardware changes."
}
