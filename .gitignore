# ═══════════════════════════════════════════════════════════════════════════════
# HarmonE-specific
# ═══════════════════════════════════════════════════════════════════════════════
context/
HarmonE/
# Concurrent-harness run outputs and archives (runs/, runs_5.9/, runs_old/, ...)
tool/concurrent_harness/runs*/
# Local package mirrors / lockfiles used to ship a venv to the remote machine
tool/linux_pkgs/
tool/resolved.txt
# Mutable bandit state (shared across runs; audit B7) — never commit
tool/knowledge/bandit_pending.json
tool/knowledge/bandit_state.json
# ── Experiment run outputs ────────────────────────────────────────────────────
# All (dataset × planner × seed) run directories written by run_experiment.py.
# These can be hundreds of MBs; regenerate with: python experiments/run_grid.py
tool/runs/
tool/runs_*/

# ── Live-system runtime state ─────────────────────────────────────────────────
# These files accumulate during live managed-system operation and must NOT be
# committed — they are noisy diffs that obscure real code changes.
tool/managed_system_*/knowledge/predictions.csv
tool/managed_system_*/knowledge/drift_kl.json
tool/managed_system_*/knowledge/event_log.csv
tool/managed_system_*/knowledge/mape_log.csv
tool/managed_system_*/knowledge/inferences/
tool/managed_system_*/knowledge/logs/
tool/managed_system_*/knowledge/model_reload.flag
tool/managed_system_*/knowledge/retrain_temp.yaml

# Generated by scripts/init_reference.py and scripts/init_scaler.py.
# Checked into git only as the canonical "paper reference" copy.
# Never overwrite without a deliberate decision.
tool/managed_system_*/knowledge/reference_distribution.json
tool/managed_system_*/knowledge/scaler.pkl
tool/managed_system_*/knowledge/calibration.json

# ── Versioned Model Repositories (VMR) ───────────────────────────────────────
# Weights written by retrain tactics; can be re-generated; too large for git.
tool/managed_system_*/knowledge/vmr/
tool/managed_system_regression/versionedMR/
tool/managed_system_cv/versionedMR/
tool/knowledge/vmr/

# ── CV dataset (BDD100k and similar) ─────────────────────────────────────────
# Large image datasets are stored outside the repo; mount or symlink at runtime.
tool/managed_system_cv/data/
tool/data/

# ── CV pilot output ───────────────────────────────────────────────────────────
tool/managed_system_cv/pilot/

# ── CV misc live-system artefacts ─────────────────────────────────────────────
tool/managed_system_cv/models_cached/
tool/managed_system_cv/clear_models/
tool/managed_system_cv/runs_artifact_storeaway/
tool/managed_system_cv/semi_base_models/

# ── Ultralytics YOLO training run artefacts ───────────────────────────────────
runs/detect/
runs/train/
runs/val/
tool/managed_system_cv/runs/
runs_artifact/

# ── EmbeddingStore runtime files (ring buffer, too large for git) ─────────────
tool/managed_system_*/knowledge/embeddings.f16.npy
tool/managed_system_*/knowledge/embeddings_index.csv
tool/managed_system_*/knowledge/reference_embeddings.npz

